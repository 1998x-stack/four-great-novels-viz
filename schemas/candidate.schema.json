{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review candidate",
  "type": "object",
  "required": [
    "book_id",
    "candidate_id",
    "chapter",
    "subject_id",
    "object_id",
    "status",
    "source"
  ],
  "properties": {
    "book_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^C[0-9]{4,}$"
    },
    "chapter": {
      "type": "integer",
      "minimum": 0
    },
    "subject_id": {
      "type": "string",
      "pattern": "^P[0-9]{4,}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^P[0-9]{4,}$"
    },
    "status": {
      "enum": [
        "pending",
        "reviewed",
        "rejected"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "edition_id",
        "chapter",
        "evidence_level"
      ],
      "properties": {
        "edition_id": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_level": {
          "enum": [
            "keyword_match",
            "chapter_only",
            "anchored_paragraph",
            "reviewed"
          ]
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
