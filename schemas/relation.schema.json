{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "relation",
  "type": "object",
  "properties": {
    "relation_id": {
      "type": "string",
      "pattern": "^R[0-9]{4,}$"
    },
    "book_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^P[0-9]{4,}$"
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "pattern": "^P[0-9]{4,}$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "subject_to_object",
        "symmetric"
      ]
    },
    "valid_from_chapter": {
      "type": "integer",
      "minimum": 0
    },
    "valid_to_chapter": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "relation_id",
    "book_id",
    "subject_id",
    "predicate",
    "object_id",
    "category",
    "direction"
  ],
  "additionalProperties": true
}
