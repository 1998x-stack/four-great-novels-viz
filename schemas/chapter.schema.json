{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chapter",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "chapter": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "edition_id": {
      "type": "string",
      "minLength": 1
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    }
  },
  "required": [
    "book_id",
    "chapter",
    "title",
    "edition_id",
    "review_status"
  ],
  "additionalProperties": true
}
